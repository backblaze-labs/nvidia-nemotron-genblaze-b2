# Backblaze B2 (parent standard names — DO NOT rename or alias)
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=

# NVIDIA NIM (sign up at https://build.nvidia.com — one nvapi- key covers
# chat, image, audio TTS, music, and (best-effort) Cosmos video)
NVIDIA_API_KEY=nvapi-

# Optional — observability and dev
OTEL_ENDPOINT=
STEP_CACHE_DIR=.cache/nemotron

# Optional — Next.js proxy target
NEMOTRON_API_URL=http://127.0.0.1:8787

# Optional — model overrides (defaults sit on the free tier)
NEMOTRON_CHAT_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NEMOTRON_REASONING=true
NEMOTRON_IMAGE_MODEL=black-forest-labs/flux.1-schnell
NEMOTRON_TTS_MODEL=nvidia/magpie-tts-multilingual
NEMOTRON_MUSIC_MODEL=nvidia/fugatto
NEMOTRON_VIDEO_MODEL=nvidia/cosmos-2.0-diffusion-text2world

# Optional — upload guardrail (bytes; default 25 MiB)
MAX_UPLOAD_BYTES=26214400
